{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "bot_name": "storepilot-self-learning",
  "strategy": "SelfLearningStrategy",
  "freqaimodel": "LightGBMRegressor",

  "dry_run": true,
  "dry_run_wallet": 65,
  "db_url": "sqlite:///user_data/tradesv3.ml.dryrun.sqlite",
  "stake_currency": "USD",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 0.99,
  "max_open_trades": 2,
  "timeframe": "1h",
  "trading_mode": "spot",
  "cancel_open_orders_on_exit": false,
  "dataformat_ohlcv": "feather",

  "unfilledtimeout": {
    "entry": 10,
    "exit": 10,
    "exit_timeout_count": 0,
    "unit": "minutes"
  },
  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0.0,
    "check_depth_of_market": { "enabled": false, "bids_to_ask_delta": 1 }
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },

  "exchange": {
    "name": "kraken",
    "key": "",
    "secret": "",
    "ccxt_config": {},
    "ccxt_async_config": {},
    "pair_whitelist": ["BTC/USD", "ETH/USD", "SOL/USD"],
    "pair_blacklist": []
  },
  "pairlists": [{ "method": "StaticPairList" }],

  "freqai": {
    "enabled": true,
    "override_exchange_checks": true,
    "identifier": "self-learning-v1",
    "purge_old_models": 2,
    "train_period_days": 60,
    "backtest_period_days": 7,
    "live_retrain_hours": 6,
    "expiration_hours": 12,
    "fit_live_predictions_candles": 300,
    "data_kitchen_thread_count": 2,
    "feature_parameters": {
      "include_timeframes": ["1h", "4h"],
      "include_corr_pairlist": ["BTC/USD"],
      "label_period_candles": 12,
      "include_shifted_candles": 1,
      "indicator_periods_candles": [12, 48],
      "weight_factor": 0.9,
      "DI_threshold": 0.9,
      "principal_component_analysis": false,
      "use_SVM_to_remove_outliers": false,
      "plot_feature_importances": 0
    },
    "data_split_parameters": {
      "test_size": 0.1,
      "random_state": 1,
      "shuffle": false
    },
    "model_training_parameters": {
      "n_estimators": 300,
      "learning_rate": 0.03,
      "num_leaves": 15,
      "min_child_samples": 40,
      "subsample": 0.8,
      "subsample_freq": 1,
      "colsample_bytree": 0.6,
      "reg_lambda": 1.0,
      "verbosity": -1,
      "n_jobs": 2
    }
  },

  "stoploss": -0.05,
  "trailing_stop_positive_offset": 0.025,
  "selflearning": {
    "min_edge": 0.012,
    "signal_strength": 1.0,
    "streak_lookback": 6,
    "streak_penalty": 1.5
  },

  "initial_state": "running",
  "internals": {
    "process_throttle_secs": 5
  }
}
